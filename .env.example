DJANGO_READ_DOT_ENV_FILE=True
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/momcare_backend
REDIS_URL=memory://localhost/

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# EMAIL - fill in real credentials in your local .env only.
# Never commit actual credentials - .env is git-ignored.
#
# Plain SMTP, so any provider works and switching is a config change rather
# than a code change. This project uses Resend; the values below are its
# shape. Gmail is not a workable option - it blocks application sending.
#
# The sending domain must be verified with the provider before anything is
# delivered. Until then every send fails, which matters more than it sounds:
# staff invitations go out by email, so an unverified domain means nobody can
# be invited.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.resend.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
# Resend uses the literal username "resend"; the password is the API key.
DJANGO_EMAIL_HOST_USER=resend
DJANGO_EMAIL_HOST_PASSWORD=re_your_api_key_here
# Must be an address at a domain verified with the provider.
DJANGO_DEFAULT_FROM_EMAIL=MomCare <noreply@your-verified-domain>

# Base for links inside those emails (invitations, password reset). Must be an
# address the RECIPIENT can open - localhost is their machine, not yours.
DJANGO_FRONTEND_URL=http://localhost:3000

# Demo data. Required by `manage.py seed_demo`, which refuses to invent one
# because a generated password would end up in the deploy log.
DJANGO_DEMO_PASSWORD=set-a-strong-password-here

# How many proxies sit in front of the app in production. Without it DRF keys
# throttles on the whole X-Forwarded-For header, which a client can forge to
# get a fresh bucket and walk past the login rate limit.
DJANGO_NUM_PROXIES=1
